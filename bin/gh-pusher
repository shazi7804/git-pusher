#!/usr/bin/env bash
# gh-pusher — push the current repo to GitHub from inside a throwaway container,
# so no token, SSH key or git identity is ever configured on this Mac.
set -euo pipefail

IMAGE=${GH_PUSHER_IMAGE:-gh-pusher:latest}
SERVICE=gh-pusher
ACCOUNT=github-token
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gh-pusher/config"

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do self=$(readlink "$self"); done
PROJECT_DIR=$(cd -- "$(dirname -- "$self")/.." && pwd)

say()  { printf 'gh-pusher: %s\n' "$1"; }
die()  { printf 'gh-pusher: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: gh-pusher [options] [-- git-push-args...]
       gh-pusher <command>

Pushes the current git repository to GitHub from inside a container.

Options:
  -m, --message MSG    stage everything and commit with MSG before pushing
  -r, --remote NAME    remote whose URL to resolve (default: origin)
  -C, --dir PATH       repository to push (default: current directory)

Commands:
  login      store a GitHub token in the macOS Keychain (prompts, never echoed)
  logout     delete the stored token
  build      rebuild the container image
  shell      open a shell in the container with the repo mounted at /repo
  help       show this message

Examples:
  gh-pusher                            # push current branch
  gh-pusher -m "fix: typo"             # commit everything, then push
  gh-pusher -- --force-with-lease      # pass flags through to git push
EOF
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found on PATH"
  docker info >/dev/null 2>&1 || die "docker daemon is not running"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return
  say "image $IMAGE not found, building it once..."
  build_image
}

build_image() {
  docker build -q -t "$IMAGE" "$PROJECT_DIR" >/dev/null
  say "built $IMAGE"
}

# Token resolution order, first hit wins:
#   1. $GH_TOKEN / $GITHUB_TOKEN in the environment
#   2. gh-pusher's own keychain item (created by `gh-pusher login`)
#   3. whatever git's osxkeychain helper already stored for github.com
# 3 means an existing `git push` credential is reused with no setup at all.
# Sets the globals TOKEN and TOKEN_SOURCE. First hit wins:
#   1. $GH_TOKEN / $GITHUB_TOKEN in the environment
#   2. gh-pusher's own keychain item (created by `gh-pusher login`)
#   3. whatever git's osxkeychain helper already stored for github.com
# 3 means an existing `git push` credential is reused with no setup at all.
resolve_token() {
  TOKEN=""; TOKEN_SOURCE=""
  if [ -n "${GH_TOKEN:-}" ]; then
    TOKEN=$GH_TOKEN; TOKEN_SOURCE="environment (GH_TOKEN)"; return
  fi
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    TOKEN=$GITHUB_TOKEN; TOKEN_SOURCE="environment (GITHUB_TOKEN)"; return
  fi
  if TOKEN=$(security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null); then
    TOKEN_SOURCE="keychain ($SERVICE)"; return
  fi
  if TOKEN=$(security find-internet-password -s github.com -w 2>/dev/null) && [ -n "$TOKEN" ]; then
    TOKEN_SOURCE="keychain (git osxkeychain, github.com)"; return
  fi
  die "no GitHub token found. Run: gh-pusher login"
}

cmd_login() {
  say "paste a GitHub fine-grained PAT with 'Contents: Read and write'"
  # -w as the final argument makes `security` prompt; the token never touches
  # argv, the shell history, or disk in plaintext.
  security add-generic-password -U -s "$SERVICE" -a "$ACCOUNT" \
    -l "gh-pusher GitHub token" -w
  say "token saved to the login keychain"

  local name email
  name=$(config_get name || true)
  email=$(config_get email || true)
  if [ -z "$name" ] || [ -z "$email" ]; then
    read -r -p "commit author name: " name
    read -r -p "commit author email: " email
    mkdir -p "$(dirname "$CONFIG_FILE")"
    printf 'name=%s\nemail=%s\n' "$name" "$email" > "$CONFIG_FILE"
    say "identity saved to $CONFIG_FILE"
  fi
}

cmd_logout() {
  security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" >/dev/null 2>&1 \
    && say "token deleted" || say "no token was stored"
}

config_get() {
  [ -f "$CONFIG_FILE" ] || return 1
  local v
  v=$(sed -n "s/^$1=//p" "$CONFIG_FILE" | head -1)
  [ -n "$v" ] || return 1
  printf '%s' "$v"
}

repo_root() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null \
    || die "$1 is not inside a git repository"
}

run_container() {
  local root=$1; shift
  resolve_token
  say "token from $TOKEN_SOURCE"

  # Only pin an identity if the user configured one; otherwise the container
  # asks GitHub who the token belongs to, so there is nothing to set up.
  local ident=()
  local name email
  if name=$(config_get name) && email=$(config_get email); then
    ident=(-e GIT_AUTHOR_NAME="$name" -e GIT_AUTHOR_EMAIL="$email"
           -e GIT_COMMITTER_NAME="$name" -e GIT_COMMITTER_EMAIL="$email")
  fi

  GH_TOKEN="$TOKEN" docker run --rm -i \
    -v "$root:/repo" \
    -e GH_TOKEN \
    -e GH_PUSHER_COMMIT_MSG="$COMMIT_MSG" \
    -e GH_PUSHER_REMOTE="$REMOTE" \
    ${ident[@]+"${ident[@]}"} \
    ${EXTRA_DOCKER_ARGS[@]+"${EXTRA_DOCKER_ARGS[@]}"} \
    "$IMAGE" "$@"
}

COMMIT_MSG=""
REMOTE="origin"
REPO_DIR="$PWD"
EXTRA_DOCKER_ARGS=()

case "${1:-}" in
  login)        cmd_login; exit 0 ;;
  logout)       cmd_logout; exit 0 ;;
  build)        require_docker; build_image; exit 0 ;;
  help|-h|--help) usage; exit 0 ;;
  shell)
    shift
    require_docker; ensure_image
    EXTRA_DOCKER_ARGS=(-t --entrypoint /bin/sh)
    run_container "$(repo_root "$REPO_DIR")"
    exit 0
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message) COMMIT_MSG=${2:?-m needs a message}; shift 2 ;;
    -r|--remote)  REMOTE=${2:?-r needs a remote name}; shift 2 ;;
    -C|--dir)     REPO_DIR=${2:?-C needs a path}; shift 2 ;;
    --)           shift; break ;;
    -*)           die "unknown option: $1 (see gh-pusher help)" ;;
    *)            die "unexpected argument: $1 (git push flags go after --)" ;;
  esac
done

require_docker
ensure_image
run_container "$(repo_root "$REPO_DIR")" "$@"
