#!/bin/sh
# Runs inside the container. Pushes the repo bind-mounted at /repo to GitHub
# over HTTPS using GH_TOKEN. Never writes credentials into /repo/.git/config.
set -eu

say() { printf 'gh-pusher: %s\n' "$1"; }
die() { printf 'gh-pusher: %s\n' "$1" >&2; exit 1; }

[ -n "${GH_TOKEN:-}" ] || die "GH_TOKEN is not set"
[ -d /repo/.git ] || [ -f /repo/.git ] || die "/repo is not a git repository"

git config --global safe.directory /repo
git config --global credential.helper \
  '!f() { [ "$1" = get ] && { echo username=x-access-token; echo "password=$GH_TOKEN"; }; }; f'

cd /repo

# Ask GitHub who this token belongs to, so committing needs no local identity.
# GitHub hides the email of accounts that keep it private, hence the noreply
# fallback, which GitHub accepts and links to the account.
resolve_identity() {
  [ -z "${GIT_AUTHOR_EMAIL:-}" ] || return 0
  local login name email
  login=$(gh api user --jq '.login' 2>/dev/null) || {
    say "warning: could not reach the GitHub API, committing as gh-pusher"
    login=gh-pusher
  }
  name=$(gh api user --jq '.name // .login' 2>/dev/null) || name=$login
  email=$(gh api user --jq '.email // ""' 2>/dev/null) || email=""
  [ -n "$email" ] || email="$login@users.noreply.github.com"

  export GIT_AUTHOR_NAME="$name"    GIT_AUTHOR_EMAIL="$email"
  export GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email"
  say "commit identity: $name <$email>"
}

if [ -n "${GH_PUSHER_COMMIT_MSG:-}" ]; then
  resolve_identity
  git add -A
  if git diff --cached --quiet; then
    say "nothing to commit"
  else
    git commit -q -m "$GH_PUSHER_COMMIT_MSG"
    say "committed: $(git log -1 --pretty='%h %s')"
  fi
elif ! git diff --quiet || ! git diff --cached --quiet; then
  say "note: uncommitted changes present, pushing committed history only (use -m to commit)"
fi

# A tag is created here rather than on the host so the annotation carries the
# token's identity, the same one used for commits. An existing tag is pushed
# untouched, which is how you ship a tag that was made before gh-pusher ran.
tag=${GH_PUSHER_TAG:-}
if [ -n "$tag" ]; then
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    say "tag $tag already exists at $(git rev-parse --short "refs/tags/$tag^{commit}"), pushing it as-is"
  else
    resolve_identity
    git tag -a "$tag" -m "${GH_PUSHER_TAG_MSG:-$tag}"
    say "tagged $(git rev-parse --short HEAD) as $tag"
  fi
fi

branch=$(git symbolic-ref --short -q HEAD) \
  || die "HEAD is detached; check out a branch first"

remote=${GH_PUSHER_REMOTE:-origin}
url=$(git remote get-url "$remote" 2>/dev/null) \
  || die "remote '$remote' not found (add it with: git remote add $remote <url>)"

# Normalise any GitHub remote form to a token-friendly HTTPS URL. The URL is
# only ever passed as a push argument, so the repo's own remote is untouched.
case "$url" in
  git@github.com:*)       path=${url#git@github.com:} ;;
  ssh://git@github.com/*) path=${url#ssh://git@github.com/} ;;
  https://*@github.com/*) path=${url#*@github.com/} ;;
  https://github.com/*)   path=${url#https://github.com/} ;;
  *) die "unsupported remote (github.com only): $url" ;;
esac
push_url="https://github.com/${path%.git}.git"

if [ -n "$tag" ]; then
  say "pushing $branch + tag $tag -> ${path%.git}"
  git push "$push_url" "HEAD:refs/heads/$branch" "refs/tags/$tag" "$@"
else
  say "pushing $branch -> ${path%.git}"
  git push "$push_url" "HEAD:refs/heads/$branch" "$@"
fi
say "done"
